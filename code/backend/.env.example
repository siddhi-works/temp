# Suchana Setu / Samyukta backend settings.
# Copy to .env and fill in the blanks. Never commit .env (it is gitignored).
# Every service key is optional for local work; GET /ready shows which are set.

# --- Core -----------------------------------------------------------------
# dev | prod (prod enforces secrets and webhook signatures)
ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TIMEZONE=Asia/Kolkata

# SQLite locally. For Supabase/Postgres: postgresql+asyncpg://user:pass@host:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./suchana.db
STORAGE_DIR=./storage

# --- Secrets (generate your own; required when ENV=prod) -------------------
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=

# --- Sarvam AI: scan reading (OCR), voice (TTS), speech-to-text -------------
SARVAM_API_KEY=
# hard spending cap; 5500 = Rs 55 of a Rs 70 credit
SARVAM_BUDGET_PAISE=5500
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=
SARVAM_OCR_PAISE_PER_PAGE=50
SARVAM_TTS_PAISE_PER_1K_CHARS=300
SARVAM_STT_PAISE_PER_MIN=49

# --- Google: Gemini (understanding, backup OCR, questions) and Cloud TTS ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cheaper model for short jobs (labels, short answers). Leave blank to use GEMINI_MODEL.
GEMINI_LIGHT_MODEL=
GOOGLE_TTS_API_KEY=

# --- WhatsApp Cloud API (Meta developer app > WhatsApp > API setup) --------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# any string; type the same one in Meta's webhook setup
WHATSAPP_VERIFY_TOKEN=suchana-verify
# The public number students message (digits with country code). Shown as the QR / Open WhatsApp link on the website.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0
# approved utility template name (optional)
WHATSAPP_NOTICE_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# --- Behaviour ------------------------------------------------------------
PUBLISH_LANGS=en
REMINDER_OFFSETS_DAYS=3,1,0
REMINDER_HOUR_LOCAL=9
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=6
SNAP_MAX_SIDE_PX=1600
PDF_TEXT_LAYER=true
MAX_IMAGE_SIDE_PX=2500
STUDENT_DAILY_FORWARD_LIMIT=25
PUBLIC_CHECK_PER_MINUTE=10

# --- Worker -----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=3
WORKER_POLL_SECONDS=1.0
JOB_LEASE_SECONDS=180
JOB_MAX_ATTEMPTS=5

# --- Web Push for Buzz Codes (vibration patterns). Make keys: python -m scripts.make_vapid_keys ---
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.org

# --- Exam Eve Pack ---
# What students are reminded to carry (comma separated)
EXAM_EVE_CHECKLIST=hall ticket,college ID card,pen
EXAM_EVE_HOUR_LOCAL=20

GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
