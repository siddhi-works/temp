{
  "name": "Saathi Campus",
  "short_name": "Saathi",
  "start_url": "/me",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#15184a",
  "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "notice", "accept": ["image/*", "application/pdf"] }] }
  }
}
